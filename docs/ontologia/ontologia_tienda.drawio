  <diagram id="1.-Esquema" name="1. Esquema">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b style=&quot;font-size:22px;color:#0B2E4F&quot;&gt;Ontología de La Libreta — esquema (TBox)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4B5563&quot;&gt;Clases, jerarquía de subclases y propiedades. Las clases se muestran con sus atributos tipados; las flechas de objeto van del dominio al rango.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1680" height="60" as="geometry"/>
        </mxCell>        <mxCell id="escritura" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;ProductoDeEscritura&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:10px;color:#7A5B00;font-style:italic&quot;&gt;hereda atributos de Producto&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #333333;margin:4px 0 6px 0&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.5&quot;&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
