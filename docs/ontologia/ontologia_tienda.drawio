          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>        <mxCell id="annotation-hierarchy" value="La jerarquía no crea tablas: las subclases son conceptos del dominio." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#4B5563;fontStyle=2;" vertex="1" parent="1">
