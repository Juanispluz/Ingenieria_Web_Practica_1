          <mxGeometry x="60" y="650" width="780" height="380" as="geometry"/>
        </mxCell>        <mxCell id="legend-title" value="&lt;b style=&quot;font-size:14px&quot;&gt;Leyenda&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="78" y="664" width="200" height="24" as="geometry"/>
        </mxCell>        <mxCell id="leg-class" value="&lt;b&gt;Producto&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1F4E79;strokeWidth=1.8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="708" width="140" height="32" as="geometry"/>
        </mxCell>        <mxCell id="leg-label-class" value="&lt;b&gt;Clase&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#4B5563&quot;&gt;rectángulo con nombre y atributos tipados&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="704" width="560" height="40" as="geometry"/>
        </mxCell>        <mxCell id="leg-subclass-a" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="772" width="1" height="1" as="geometry"/>
        </mxCell>        <mxCell id="leg-subclass-b" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="220" y="772" width="1" height="1" as="geometry"/>
        </mxCell>        <mxCell id="leg-subclass" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=0;endSize=12;strokeWidth=2;strokeColor=#BF9000;" edge="1" parent="1" source="leg-subclass-a" target="leg-subclass-b">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>        <mxCell id="leg-label-subclass" value="&lt;b&gt;Subclase de (⊑)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#4B5563&quot;&gt;la flecha apunta a la superclase&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="754" width="560" height="40" as="geometry"/>
        </mxCell>        <mxCell id="leg-object-a" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="822" width="1" height="1" as="geometry"/>
        </mxCell>        <mxCell id="leg-object-b" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="220" y="822" width="1" height="1" as="geometry"/>
        </mxCell>        <mxCell id="leg-object" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=12;strokeWidth=2;strokeColor=#1F2937;" edge="1" parent="1" source="leg-object-a" target="leg-object-b">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>        <mxCell id="leg-label-object" value="&lt;b&gt;Propiedad de objeto&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#4B5563&quot;&gt;enlace rotulado: dominio → rango&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="804" width="560" height="40" as="geometry"/>
        </mxCell>        <mxCell id="leg-data" value="precio : xsd:integer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1F4E79;strokeWidth=1.8;fontSize=8;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="858" width="140" height="32" as="geometry"/>
        </mxCell>        <mxCell id="leg-label-data" value="&lt;b&gt;Propiedad de datos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#4B5563&quot;&gt;atributo dentro de la clase, con tipo xsd&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="854" width="560" height="40" as="geometry"/>
        </mxCell>        <mxCell id="leg-instance-a" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="922" width="1" height="1" as="geometry"/>
        </mxCell>        <mxCell id="leg-instance-b" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="220" y="922" width="1" height="1" as="geometry"/>
        </mxCell>        <mxCell id="leg-instance" value="" style="edgeStyle=none;html=1;endArrow=open;endFill=1;endSize=12;strokeWidth=2;strokeColor=#6B7280;dashed=1;" edge="1" parent="1" source="leg-instance-a" target="leg-instance-b">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>        <mxCell id="leg-label-instance" value="&lt;b&gt;instanciaDe&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#4B5563&quot;&gt;pertenencia individuo → clase (página 2)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="904" width="560" height="40" as="geometry"/>
        </mxCell>        <mxCell id="leg-ind" value="&lt;span style=&quot;text-decoration:underline&quot;&gt;ana&lt;/span&gt; : Comprador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;strokeWidth=1.6;dashed=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="80" y="958" width="160" height="32" as="geometry"/>
        </mxCell>        <mxCell id="leg-label-individual" value="&lt;b&gt;Individuo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#4B5563&quot;&gt;nombre subrayado; clase después de «:»&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="954" width="560" height="40" as="geometry"/>
        </mxCell>        <mxCell id="notes" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=1.5;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="880" y="650" width="860" height="380" as="geometry"/>
        </mxCell>        <mxCell id="notes-title" value="&lt;b style=&quot;font-size:14px&quot;&gt;Decisiones y alcance&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="898" y="664" width="400" height="24" as="geometry"/>
        </mxCell>        <mxCell id="notes-body" value="• Dos subclases justificadas por el catálogo: ProductoDeEscritura (Cuaderno, Bolígrafo,&lt;br&gt;  Resaltador, Agenda) y ProductoDeOrganizacion (Carpeta, Estuche). No se declaran disjuntas.&lt;br&gt;• Comprador se reifica como clase aunque SQLite guarde nombre y correo en pedidos.&lt;br&gt;  No se crea una tabla nueva: la ontología describe al agente, no solo dos columnas.&lt;br&gt;• precioUnitarioCompra es el precio congelado de la línea; precioActual es el precio vigente&lt;br&gt;  del catálogo. Si cambia el precio actual, el pedido histórico no se altera.&lt;br&gt;• totalPedido y subtotalLinea son valores derivados de las líneas; no son precios enviados&lt;br&gt;  por el cliente. La app los calcula con los precios de SQLite.&lt;br&gt;• La ontología describe significados y hechos; no valida formularios ni ejecuta inferencias.&lt;br&gt;  Las reglas (cantidad &amp;gt; 0, correo con @, al menos un ítem) viven en la aplicación.&lt;br&gt;• Alcance: catálogo, comprador, pedido y detalle. Fuera: pago, envío, inventario, cuentas,&lt;br&gt;  descuentos y reseñas.&lt;br&gt;• Cardinalidades: cada Pedido tiene 1..* DetallePedido y exactamente 1 Comprador; cada&lt;br&gt;  DetallePedido corresponde a exactamente 1 Producto.&lt;br&gt;• En los extremos, el número indica cuántas instancias de esa clase participan por instancia&lt;br&gt;  de la otra (p. ej., 1 comprador por pedido; 1..* detalles por pedido)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;lineHeight=1.35;" vertex="1" parent="1">
          <mxGeometry x="898" y="696" width="824" height="320" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="2.-Individuos" name="2. Individuos">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b style=&quot;font-size:22px;color:#0B2E4F&quot;&gt;Ontología de La Libreta — individuos y hechos (ABox)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4B5563&quot;&gt;Instancias de las clases del esquema. El nombre subrayado y el sufijo «: Clase» indican pertenencia; las líneas discontinuas conectan cada individuo con su clase.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1780" height="60" as="geometry"/>
        </mxCell>        <mxCell id="chip-comprador" value="&lt;b&gt;«Clase» Comprador&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="250" height="50" as="geometry"/>
        </mxCell>        <mxCell id="chip-pedido" value="&lt;b&gt;«Clase» Pedido&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="110" width="300" height="50" as="geometry"/>
        </mxCell>        <mxCell id="chip-detalle" value="&lt;b&gt;«Clase» DetallePedido&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="355" width="290" height="50" as="geometry"/>
        </mxCell>        <mxCell id="chip-escritura" value="&lt;b&gt;«Clase» ProductoDeEscritura&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1420" y="365" width="350" height="50" as="geometry"/>
        </mxCell>        <mxCell id="chip-organizacion" value="&lt;b&gt;«Clase» ProductoDeOrganizacion&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1420" y="835" width="350" height="50" as="geometry"/>
        </mxCell>        <mxCell id="ana" value="&lt;div style=&quot;text-align:left;font-size:12px&quot;&gt;&lt;span style=&quot;text-decoration:underline;font-weight:bold&quot;&gt;ana&lt;/span&gt; : Comprador&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #374151;margin:4px 0 6px 0&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:10px;line-height:1.55&quot;&gt;&lt;div&gt;nombreComprador  &amp;quot;Ana Ejemplo&amp;quot;&lt;/div&gt;&lt;div&gt;correoComprador  &amp;quot;ana@example.com&amp;quot;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="250" height="150" as="geometry"/>
