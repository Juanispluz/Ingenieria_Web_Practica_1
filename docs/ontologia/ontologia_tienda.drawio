          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>        <mxCell id="notes" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=1.5;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="650" height="310" as="geometry"/>
        </mxCell>        <mxCell id="notes-title" value="&lt;b style=&quot;font-size:14px&quot;&gt;Hechos declarados y consecuencia inferida&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="58" y="534" width="500" height="24" as="geometry"/>
        </mxCell>        <mxCell id="notes-body" value="Declarado (ABox):&lt;br&gt;• ana realizaPedido pedido001.&lt;br&gt;• pedido001 tieneDetalle detalle001 y detalle002.&lt;br&gt;• detalle001 correspondeA cuaderno001; detalle002 correspondeA boligrafo001.&lt;br&gt;• Valores de datos: 2 × 12000 = 24000 y 1 × 2500 = 2500; total 26500.&lt;br&gt;&amp;nbsp;&lt;br&gt;Inferido por la jerarquía (TBox):&lt;br&gt;ProductoDeEscritura es subclase de Producto  +  cuaderno001 : ProductoDeEscritura&lt;br&gt;∴ cuaderno001 : Producto. Igual para boligrafo001 y carpeta001.&lt;br&gt;&amp;nbsp;&lt;br&gt;carpeta001 no se enlaza en pedido001: se incluye para mostrar la segunda&lt;br&gt;subclase y responder la pregunta 3. El mínimo de seis individuos se cumple&lt;br&gt;con siete (1 comprador, 1 pedido, 2 detalles y 3 productos)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;lineHeight=1.3;" vertex="1" parent="1">
