          <mxGeometry x="1280" y="440" width="34" height="20" as="geometry"/>
        </mxCell>        <mxCell id="e-sub-escritura" value="&lt;b&gt;esSubclaseDe&lt;/b&gt;" style="edgeStyle=none;html=1;endArrow=block;endFill=0;endSize=16;strokeWidth=2;strokeColor=#BF9000;fontSize=10;fontColor=#BF9000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="escritura" target="producto">
