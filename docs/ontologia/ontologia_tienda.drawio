        </mxCell>        <mxCell id="i-realiza" value="&lt;b&gt;realizaPedido&lt;/b&gt;" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=12;strokeWidth=2;strokeColor=#1F2937;fontSize=10;fontColor=#0B5394;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ana" target="pedido001">
